---
/** 全站搜索。索引来自 /search.json，第一次打开时才加载。 */
---

<dialog class="search" data-search aria-label="搜索">
  <input class="search-input" type="search" placeholder="搜页面、知识点、术语" autocomplete="off" spellcheck="false" data-search-input />
  <div class="search-results" data-search-results></div>
</dialog>

<script>
  interface Item {
    t: 'page' | 'point' | 'issue' | 'term';
    title: string;
    sub: string;
    href: string;
    text: string;
  }
  const TYPE = { page: '页面', point: '知识点', issue: '问题', term: '术语' };
  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const list = dialog.querySelector<HTMLElement>('[data-search-results]')!;
  let items: Item[] | null = null;
  let selected = 0;

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const mark = (s: string, tokens: string[]) => {
    let out = esc(s);
    for (const t of tokens) {
      const i = out.toLowerCase().indexOf(esc(t));
      if (i >= 0) out = `${out.slice(0, i)}<mark>${out.slice(i, i + esc(t).length)}</mark>${out.slice(i + esc(t).length)}`;
    }
    return out;
  };
  const snippet = (text: string, token: string) => {
    const i = text.toLowerCase().indexOf(token);
    if (i < 0) return '';
    const start = Math.max(0, i - 12);
    return (start > 0 ? '…' : '') + text.slice(start, start + 60);
  };

  function render() {
    const q = input.value.trim().toLowerCase();
    const tokens = q.split(/\s+/).filter(Boolean);
    if (!items) {
      list.innerHTML = '<p class="search-empty">正在加载索引…</p>';
      return;
    }
    if (!tokens.length) {
      list.innerHTML = '<p class="search-empty">输入关键词，比如：叶酸、无痛、月嫂、漏尿、NT。多个词用空格隔开。</p>';
      return;
    }
    const hits = items
      .map((it) => {
        const title = it.title.toLowerCase();
        const sub = it.sub.toLowerCase();
        const text = it.text.toLowerCase();
        let score = 0;
        for (const t of tokens) {
          if (title.includes(t)) score += title === t ? 20 : 10;
          else if (sub.includes(t)) score += 4;
          else if (text.includes(t)) score += 1;
          else return null;
        }
        return { it, score: score + (it.t === 'page' ? 1 : 0) };
      })
      .filter((x): x is { it: Item; score: number } => x !== null)
      .sort((a, b) => b.score - a.score)
      .slice(0, 30);

    if (!hits.length) {
      list.innerHTML = '<p class="search-empty">没找到。换个说法，或者这部分还没写。</p>';
      return;
    }
    selected = Math.min(selected, hits.length - 1);
    list.innerHTML = hits
      .map(({ it }, i) => {
        const inHead = tokens.some((t) => (it.title + it.sub).toLowerCase().includes(t));
        const sub = inHead ? it.sub : snippet(it.text, tokens[0]) || it.sub;
        return `<a class="search-item" href="${esc(it.href)}" aria-selected="${i === selected}">
          <span class="search-type">${TYPE[it.t]}</span>
          <span><span class="search-title">${mark(it.title, tokens)}</span><span class="search-sub">${mark(sub, tokens)}</span></span>
        </a>`;
      })
      .join('');
  }

  function move(delta: number) {
    const rows = list.querySelectorAll<HTMLElement>('.search-item');
    if (!rows.length) return;
    selected = (selected + delta + rows.length) % rows.length;
    rows.forEach((r, i) => r.setAttribute('aria-selected', String(i === selected)));
    rows[selected].scrollIntoView({ block: 'nearest' });
  }

  async function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    render();
    if (!items) {
      try {
        items = await (await fetch('/search.json')).json();
      } catch {
        items = [];
      }
      render();
    }
  }

  input.addEventListener('input', () => {
    selected = 0;
    render();
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), move(1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), move(-1));
    else if (e.key === 'Enter') {
      const row = list.querySelectorAll<HTMLAnchorElement>('.search-item')[selected];
      if (row) location.href = row.href;
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
    else if ((e.target as HTMLElement).closest('.search-item')) dialog.close();
  });
  document.addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement).tagName);
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
</script>
